# ============================================
# Embed Chatbot - Environment Configuration
# ============================================

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/embed_chatbot

# PostgreSQL (for Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=embed_chatbot

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=150
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# LLM API Keys
GROQ_API_KEY=your-groq-api-key

# Vision Model Configuration
# Provider options: "gemini" (default, free tier) or "groq"
VISION_MODEL_PROVIDER=gemini
# Get free API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8000

# Widget
VITE_PUBLIC_API_URL=http://localhost:8000

# Email Configuration for Password Reset
# 
# SMTP Settings - Configure for your email provider
# For Gmail, use these settings:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true

# Your email credentials
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password  # For Gmail, use App Password, not regular password

# Email settings
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME="Your Chatbot Platform"

# Frontend URL (where reset links will point)
FRONTEND_URL=http://localhost:3000

# Password reset token expiration (in hours)
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
# Node modules - exclude from all builds
**/node_modules
**/.pnpm-store
**/.next
**/out
**/dist
**/build

# Python cache
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache
**/.mypy_cache

# Environment files
**/.env
**/.env.*
!**/.env.example

# IDE
**/.vscode
**/.idea
**/*.swp
**/*.swo

# OS
**/.DS_Store
**/Thumbs.db

# Logs
**/*.log
**/npm-debug.log
**/yarn-error.log

# Testing
**/coverage
**/.nyc_output

# TypeScript
**/*.tsbuildinfo

# Git
**/.git
**/.gitignore

# Docker
**/.dockerignore
**/Dockerfile
**/docker-compose*.yml

# Local test/analysis scripts at workspace root (not part of the app)
_*.*
*.ps1
*.sql
analyze_data.py
check_*.py
crawl_*.py
debug_*.py
extract_*.py
generate_*.py
lang_test*.py
list_*.py
missing_info*.py
post_fix_test*.py
quick_*.py
*.txt
!requirements.txt

# JSON test data at root
*.json
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml

# Documentation
**/README.md
**/*.md
!apps/*/README.md

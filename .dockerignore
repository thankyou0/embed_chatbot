# Node modules - exclude from all builds
**/node_modules
**/.pnpm-store
**/.next
**/out
**/dist
**/build

# Python cache
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache
**/.mypy_cache

# Environment files
**/.env
**/.env.*
!**/.env.example

# IDE
**/.vscode
**/.idea
**/*.swp
**/*.swo

# OS
**/.DS_Store
**/Thumbs.db

# Logs
**/*.log
**/npm-debug.log
**/yarn-error.log

# Testing
**/coverage
**/.nyc_output

# TypeScript
**/*.tsbuildinfo

# Git
**/.git
**/.gitignore

# Docker
**/.dockerignore
**/Dockerfile
**/docker-compose*.yml

# Documentation
**/README.md
**/*.md
!apps/*/README.md

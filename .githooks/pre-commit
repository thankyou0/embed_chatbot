#!/bin/sh
# pre-commit hook — runs automatically before every `git commit`
# Blocks commits that contain secrets or sensitive files.
#
# SETUP (one-time, already done if you ran setup-hooks.ps1):
#   git config core.hooksPath .githooks

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

ERRORS=0

# ─────────────────────────────────────────────
# CHECK 1: Block .env files from being committed
# ─────────────────────────────────────────────
# `git diff --cached --name-only` lists all files staged for this commit.
# We check if any of them match .env patterns.

ENV_FILES=$(git diff --cached --name-only | grep -E '(^|/)\.env$|(^|/)\.env\.')

if [ -n "$ENV_FILES" ]; then
    echo ""
    echo "${RED}[BLOCKED] .env file(s) staged for commit:${NC}"
    echo "$ENV_FILES" | while read -r f; do echo "  → $f"; done
    echo ""
    echo "${YELLOW}  These files contain secrets (GEMINI_API_KEY, HUGGINGFACE_API_TOKEN, etc.)${NC}"
    echo "${YELLOW}  They are in .gitignore — do NOT force-add them.${NC}"
    echo ""
    ERRORS=1
fi

# ─────────────────────────────────────────────
# CHECK 2: Scan staged files for hardcoded secrets
# ─────────────────────────────────────────────
# Looks for common secret patterns in the actual diff content.
# Only scans staged lines (lines starting with `+` in the diff).

SECRET_PATTERN='(GEMINI_API_KEY|HUGGINGFACE_API_TOKEN|SECRET_KEY|sk-[a-zA-Z0-9]{20,}|AIza[0-9A-Za-z_-]{35}|password\s*=\s*["\x27][^"\x27]{4,})'

FOUND_SECRETS=$(git diff --cached | grep -E '^\+' | grep -v '^\+\+\+' | grep -iE "$SECRET_PATTERN")

if [ -n "$FOUND_SECRETS" ]; then
    echo ""
    echo "${RED}[BLOCKED] Possible hardcoded secret detected in staged changes:${NC}"
    echo "$FOUND_SECRETS" | head -5
    echo ""
    echo "${YELLOW}  Move secrets to .env and load via config.py / process.env${NC}"
    echo "${YELLOW}  To bypass (if this is a false positive): git commit --no-verify${NC}"
    echo ""
    ERRORS=1
fi

# ─────────────────────────────────────────────
# CHECK 3: Warn if docker-compose.yml has hardcoded passwords
# ─────────────────────────────────────────────
# The project uses `post` as the Postgres password — acceptable in dev,
# but warn if someone changed it to something that looks like a real password.

COMPOSE_STAGED=$(git diff --cached --name-only | grep 'docker-compose')

if [ -n "$COMPOSE_STAGED" ]; then
    COMPOSE_SECRETS=$(git diff --cached -- docker-compose.yml docker-compose.prod.yml 2>/dev/null \
        | grep -E '^\+' | grep -v '^\+\+\+' \
        | grep -iE 'POSTGRES_PASSWORD:\s*[a-zA-Z0-9]{8,}')
    if [ -n "$COMPOSE_SECRETS" ]; then
        echo "${YELLOW}[WARNING] docker-compose has a non-trivial POSTGRES_PASSWORD. Ensure it is not a real credential.${NC}"
        echo "$COMPOSE_SECRETS"
        echo ""
    fi
fi

# ─────────────────────────────────────────────
# RESULT
# ─────────────────────────────────────────────

if [ "$ERRORS" -eq 0 ]; then
    echo "${GREEN}[OK] pre-commit checks passed.${NC}"
    exit 0
else
    echo "${RED}[ABORTED] Fix the issues above, then commit again.${NC}"
    echo "         To skip all checks (use carefully): git commit --no-verify"
    exit 1  # Non-zero exit = Git aborts the commit
fi
